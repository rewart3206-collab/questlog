rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Who may use this Questlog.
    // By default: anyone who signs in with Google.
    function allowed() {
      return request.auth != null;
    }
    // To limit it to just you and your friends, replace the function above with this one
    // and list everyone's Google email addresses:
    //
    // function allowed() {
    //   return request.auth != null
    //     && request.auth.token.email_verified == true
    //     && request.auth.token.email in [
    //       'you@gmail.com',
    //       'friend1@gmail.com',
    //       'friend2@gmail.com'
    //     ];
    // }

    function isOwner(uid) {
      return allowed() && request.auth.uid == uid;
    }

    // Each player's full save. Only that player can read or change it.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['save', 'at'])
        && request.resource.data.save is string
        && request.resource.data.save.size() < 400000
        && request.resource.data.at is int;
    }

    // Public hero card shown in the Guild tab. Every player can read it; only its owner can write it.
    match /profiles/{uid} {
      allow read: if allowed();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'xp', 'level', 'cls', 'title', 'streak', 'equip', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.level is int
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.equip is map;
    }
  }
}
